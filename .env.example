# =====================================================================
# Supabase Configuration for GiftVault
# Set these in your local .env or Vercel Project Settings > Environment Variables
# =====================================================================

# Required: Your Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Required: Your Supabase Publishable / Anon Key (From Project Settings > API)
# Do NOT use your service_role secret key!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Alternative prefixes used by Vercel Supabase Integrations (auto-detected)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...